FROM nginx:alpine

ENV SCARLETX_WEB_PORT=8690

# Make the stock Nginx image safe for an arbitrary non-root UID/GID. TrueNAS
# overrides the runtime identity from the app's User and Group settings.
RUN set -eux; \
    rm -f /etc/nginx/conf.d/default.conf; \
    sed -i '/^user[[:space:]]/d' /etc/nginx/nginx.conf; \
    sed -i 's#pid[[:space:]].*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf; \
    mkdir -p /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html; \
    chmod 0777 /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html /tmp

# The official Nginx image envsubst entrypoint renders templates at startup,
# allowing TrueNAS to select the WebUI port without changing the image.
COPY nginx/scarletx.conf /etc/nginx/templates/default.conf.template
COPY scarletx/web/index.html /usr/share/nginx/html/index.html
COPY frontend/auth.css /usr/share/nginx/html/auth.css
COPY frontend/auth.js /usr/share/nginx/html/auth.js

# Bake the authentication assets into the static HTML at image-build time.
# Nginx serves the finished page directly; Python never renders or rewrites UI.
RUN set -eux; \
    sed -i 's#</head>#<link rel="stylesheet" href="/auth.css"></head>#' /usr/share/nginx/html/index.html; \
    sed -i 's#<body>#<body><script src="/auth.js"></script>#' /usr/share/nginx/html/index.html; \
    sed -i 's/^[[:space:]]*boot();[[:space:]]*$/authGateBoot(boot);/' /usr/share/nginx/html/index.html; \
    grep -q '/auth.css' /usr/share/nginx/html/index.html; \
    grep -q '/auth.js' /usr/share/nginx/html/index.html; \
    grep -q 'authGateBoot(boot);' /usr/share/nginx/html/index.html

EXPOSE 8690
USER 568:568

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${SCARLETX_WEB_PORT}/api/health" | grep -q '"app":"ScarletX"'
