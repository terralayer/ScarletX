FROM nginx:alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913

ENV SCARLETX_WEB_PORT=8690 \
    SCARLETX_BACKEND_HOST=scarletx-backend \
    SCARLETX_BACKEND_PORT=8000

RUN set -eux; \
    rm -f /etc/nginx/conf.d/default.conf; \
    sed -i '/^user[[:space:]]/d' /etc/nginx/nginx.conf; \
    sed -i 's#pid[[:space:]].*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf; \
    mkdir -p /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html; \
    chmod 0777 /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html /tmp

COPY nginx/scarletx.conf /etc/nginx/templates/default.conf.template
COPY frontend/index.html /usr/share/nginx/html/index.html
COPY frontend/auth.css /usr/share/nginx/html/auth.css
COPY frontend/auth.js /usr/share/nginx/html/auth.js
COPY frontend/styles.css /usr/share/nginx/html/styles.css
COPY frontend/app.js /usr/share/nginx/html/app.js
COPY frontend/navigation_error_overrides.js /usr/share/nginx/html/navigation_error_overrides.js
COPY frontend/ui_overrides.css /usr/share/nginx/html/ui_overrides.css
COPY frontend/ui_overrides.js /usr/share/nginx/html/ui_overrides.js
COPY frontend/activity_studio_overrides.js /usr/share/nginx/html/activity_studio_overrides.js
COPY frontend/processing_queue_overrides.js /usr/share/nginx/html/processing_queue_overrides.js
COPY frontend/activity_history_overrides.js /usr/share/nginx/html/activity_history_overrides.js
COPY frontend/wanted_bulk_overrides.js /usr/share/nginx/html/wanted_bulk_overrides.js
COPY frontend/studio_art_overrides.js /usr/share/nginx/html/studio_art_overrides.js
COPY frontend/dashboard_settings_overrides.js /usr/share/nginx/html/dashboard_settings_overrides.js
COPY frontend/dashboard_regression_hotfix.js /usr/share/nginx/html/dashboard_regression_hotfix.js
COPY frontend/library_health_overrides.js /usr/share/nginx/html/library_health_overrides.js
COPY frontend/scarletx-wordmark.webp.b64.00 /tmp/scarletx-wordmark.webp.b64.00
COPY frontend/scarletx-wordmark.webp.b64.01 /tmp/scarletx-wordmark.webp.b64.01
COPY frontend/scarletx-wordmark.webp.b64.02 /tmp/scarletx-wordmark.webp.b64.02
COPY frontend/scarletx-wordmark.webp.b64.03 /tmp/scarletx-wordmark.webp.b64.03
COPY frontend/scarletx-icon.svg /usr/share/nginx/html/scarletx-icon.svg
COPY frontend/scarletx-icon.webp /usr/share/nginx/html/scarletx-icon.webp
COPY frontend/scarletx-banner.b64.1 /tmp/scarletx-banner.b64.1
COPY frontend/scarletx-banner.b64.2 /tmp/scarletx-banner.b64.2
COPY frontend/scarletx-banner.b64.3 /tmp/scarletx-banner.b64.3
COPY frontend/scarletx-banner.b64.4 /tmp/scarletx-banner.b64.4
COPY frontend/locked_dashboard.css /usr/share/nginx/html/locked_dashboard.css
COPY frontend/locked_dashboard_footer.css /usr/share/nginx/html/locked_dashboard_footer.css
COPY frontend/approved_assets.css /usr/share/nginx/html/approved_assets.css
COPY frontend/ui_icons.css /usr/share/nginx/html/ui_icons.css
COPY frontend/dashboard_cleanup.css /usr/share/nginx/html/dashboard_cleanup.css
COPY frontend/sidebar_compact.css /usr/share/nginx/html/sidebar_compact.css

RUN set -eux; \
    cat /tmp/scarletx-banner.b64.1 /tmp/scarletx-banner.b64.2 /tmp/scarletx-banner.b64.3 /tmp/scarletx-banner.b64.4 \
      | base64 -d > /usr/share/nginx/html/scarletx-banner.webp; \
    cat /tmp/scarletx-wordmark.webp.b64.00 /tmp/scarletx-wordmark.webp.b64.01 /tmp/scarletx-wordmark.webp.b64.02 /tmp/scarletx-wordmark.webp.b64.03 \
      | base64 -d > /usr/share/nginx/html/scarletx-wordmark.webp; \
    echo '236fc1fdadd8c34fa5909dcf7d5dae6e346b410e04bf89c0409fc341fee02cad  /usr/share/nginx/html/scarletx-banner.webp' | sha256sum -c -; \
    echo 'a90efeaa68b2f8a96e20d62167582f79ed58ef92aa776e46e8c4d9bad0e3c3ca  /usr/share/nginx/html/scarletx-wordmark.webp' | sha256sum -c -; \
    echo '30f7d52a474ed83d7f6f83d8da8ec9ca3488b6936bced0072dccdf762c10e768  /usr/share/nginx/html/scarletx-icon.webp' | sha256sum -c -; \
    test -s /usr/share/nginx/html/scarletx-icon.svg; \
    test "$(head -c 4 /usr/share/nginx/html/scarletx-wordmark.webp)" = "RIFF"; \
    test "$(dd if=/usr/share/nginx/html/scarletx-wordmark.webp bs=1 skip=8 count=4 2>/dev/null)" = "WEBP"; \
    test "$(head -c 4 /usr/share/nginx/html/scarletx-icon.webp)" = "RIFF"; \
    test "$(dd if=/usr/share/nginx/html/scarletx-icon.webp bs=1 skip=8 count=4 2>/dev/null)" = "WEBP"; \
    rm -f /tmp/scarletx-banner.b64.* /tmp/scarletx-wordmark.webp.b64.*

RUN set -eux; \
    sed -i 's#</head>#<link rel="stylesheet" href="/auth.css"></head>#' /usr/share/nginx/html/index.html; \
    sed -i 's#<body\([^>]*\)>#<body\1><script src="/auth.js"></script>#' /usr/share/nginx/html/index.html; \
    sed -i 's/^[[:space:]]*boot();[[:space:]]*$/authGateBoot(boot);/' /usr/share/nginx/html/app.js; \
    grep -q '/auth.css' /usr/share/nginx/html/index.html; \
    grep -q '/auth.js' /usr/share/nginx/html/index.html; \
    grep -q '/styles.css' /usr/share/nginx/html/index.html; \
    grep -q '/ui_overrides.css' /usr/share/nginx/html/index.html; \
    grep -q '/locked_dashboard.css' /usr/share/nginx/html/index.html; \
    grep -q '/locked_dashboard_footer.css' /usr/share/nginx/html/index.html; \
    grep -q '/approved_assets.css' /usr/share/nginx/html/index.html; \
    grep -q '/ui_icons.css' /usr/share/nginx/html/index.html; \
    grep -q '/dashboard_cleanup.css' /usr/share/nginx/html/index.html; \
    grep -q '/sidebar_compact.css' /usr/share/nginx/html/index.html; \
    grep -q '/app.js' /usr/share/nginx/html/index.html; \
    grep -q '/navigation_error_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/ui_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/activity_studio_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/processing_queue_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/activity_history_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/wanted_bulk_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/studio_art_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/dashboard_settings_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/dashboard_regression_hotfix.js' /usr/share/nginx/html/index.html; \
    grep -q '/library_health_overrides.js' /usr/share/nginx/html/index.html; \
    grep -q '/scarletx-wordmark.webp?v=approved-20260915-6' /usr/share/nginx/html/index.html; \
    grep -q '/scarletx-icon.svg?v=approved-20260916-1' /usr/share/nginx/html/index.html; \
    grep -q 'authGateBoot(boot);' /usr/share/nginx/html/app.js

EXPOSE 8690
USER 568:568

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${SCARLETX_WEB_PORT}/api/health" | grep -q '"app":"ScarletX"'